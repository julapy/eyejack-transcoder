{
  "name": "@eyejack/transcoder",
  "version": "0.1.0",
  "description": "Browser-based transcoder that turns video, GIFs, and image sequences into compact, WebGL-ready H.264/MP4 — including transparent (alpha) video. Runs entirely client-side via FFmpeg WASM.",
  "license": "MIT",
  "author": "EyeJack (https://eyejack.io)",
  "homepage": "https://transcoder.eyejack.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julapy/eyejack-transcoder.git"
  },
  "bugs": {
    "url": "https://github.com/julapy/eyejack-transcoder/issues"
  },
  "keywords": [
    "webar",
    "alpha-video",
    "transparent-video",
    "ffmpeg",
    "ffmpeg-wasm",
    "webgl",
    "video-transcoding",
    "h264",
    "mp4",
    "gif-to-video",
    "image-sequence",
    "browser",
    "eyejack"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ffmpeg-assets": "./public/ffmpeg"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "src",
    "public/ffmpeg",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run -c vitest.config.ts",
    "test:watch": "vitest -c vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "idb-keyval": "^6.2.1"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "jsdom": "^24.0.0"
  }
}
